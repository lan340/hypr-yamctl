[Unit]
Description=Yandex Music like bridge (Waybar CDP helper)
After=default.target
PartOf=default.target

[Service]
Type=simple
ExecStart=/home/lan/.local/bin/ym-node /home/lan/.local/bin/ym-like-watch.js
Restart=always
RestartSec=2
Environment=NODE_PATH=/usr/lib/node_modules
Environment=PATH=/usr/bin:/usr/local/bin:/home/lan/.local/bin

[Install]
WantedBy=default.target
