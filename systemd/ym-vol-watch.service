[Unit]
Description=Yandex Music volume bridge (Waybar CDP helper)
After=default.target
PartOf=default.target

[Service]
Type=simple
ExecStart={{HOME}}/.local/bin/ym-node {{HOME}}/.local/bin/ym-vol-watch.js
Restart=always
RestartSec=2
Environment=NODE_PATH=/usr/lib/node_modules
Environment=PATH=/usr/bin:/usr/local/bin:{{HOME}}/.local/bin

[Install]
WantedBy=default.target
