#custom-ym_mpris.paused-p70  { background-image: url("svg/prog_play/play-70.svg"); padding-left: 50px; background-position: 12px center; }
#custom-ym_mpris.paused-p80  { background-image: url("svg/prog_play/play-80.svg"); padding-left: 50px; background-position: 12px center; }
#custom-ym_mpris.paused-p90  { background-image: url("svg/prog_play/play-90.svg"); padding-left: 50px; background-position: 12px center; }
#custom-ym_mpris.paused-p100 { background-image: url("svg/prog_play/play-100.svg"); padding-left: 50px; background-position: 12px center; }

#custom-ym_mpris.playing-p0   { background-image: url("svg/prog_pause/pause-00.svg"); padding-left: 50px; background-position: 12px center; }
#custom-ym_mpris.playing-p10  { background-image: url("svg/prog_pause/pause-10.svg"); padding-left: 50px; background-position: 12px center; }
#custom-ym_mpris.playing-p20  { background-image: url("svg/prog_pause/pause-20.svg"); padding-left: 50px; background-position: 12px center;  }
#custom-ym_mpris.playing-p30  { background-image: url("svg/prog_pause/pause-30.svg"); padding-left: 50px; background-position: 12px center;  }
#custom-ym_mpris.playing-p40  { background-image: url("svg/prog_pause/pause-40.svg"); padding-left: 50px; background-position: 12px center;  }
#custom-ym_mpris.playing-p50  { background-image: url("svg/prog_pause/pause-50.svg"); padding-left: 50px; background-position: 12px center;  }
#custom-ym_mpris.playing-p60  { background-image: url("svg/prog_pause/pause-60.svg"); padding-left: 50px; background-position: 12px center;  }
#custom-ym_mpris.playing-p70  { background-image: url("svg/prog_pause/pause-70.svg"); padding-left: 50px; background-position: 12px center;  }
#custom-ym_mpris.playing-p80  { background-image: url("svg/prog_pause/pause-80.svg"); padding-left: 50px; background-position: 12px center;  }
#custom-ym_mpris.playing-p90  { background-image: url("svg/prog_pause/pause-90.svg"); padding-left: 50px; background-position: 12px center;  }
#custom-ym_mpris.playing-p100 { background-image: url("svg/prog_pause/pause-100.svg"); padding-left: 50px; background-position: 12px center;  }

#custom-ym_mpris.playing,
#custom-ym_mpris.paused {
  padding-left: 80px;  /* текст смещаем чуть правее, но без огромного отступа */
}

#custom-keyboard {
  background-color: #111827;
  border-radius: 14px;
  padding: 8px;
}

#custom-ym_volume {
  background-color: #111827;
  border-radius: 14px;
  padding: 10px;
}