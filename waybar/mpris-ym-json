#!/usr/bin/env bash
set -euo pipefail

# Берём исходный JSON от твоего скрипта
o="$(~/.local/bin/mpris-ym print)"

# Достаём процент из класса "… pNN"
p="$(jq -r '.class | capture("p(?<p>[0-9]+)")?.p // "0"' <<<"$o")"

# Мелкая «полоска» блоком (без цифр)
blk=('▁' '▂' '▃' '▄' '▅' '▆' '▇' '█')
idx=$(( p / 13 ))           # 0..100 -> 0..7 (грубо)
(( idx > 7 )) && idx=7

# Добавляем блок в конец текста и печатаем валидный JSON
jq -c --arg blk "${blk[$idx]}" '.text = (.text + "  " + $blk)' <<<"$o"
