#!/usr/bin/env bash
# Только Chromium (и совместимые), + класс pXX для тонкой полоски
set -euo pipefail

pick_player() {
  local p paused=""
  while read -r p; do
    [[ -z "$p" ]] && continue
    [[ "$p" =~ ^chrom(e|ium)\. ]] || continue
    st=$(playerctl -p "$p" status 2>/dev/null || echo Stopped)
    if [[ "$st" == "Playing" ]]; then
      echo "$p"; return 0
    elif [[ "$st" == "Paused" ]]; then
      paused="$p"
    fi
  done < <(playerctl -l 2>/dev/null || true)
  [[ -n "$paused" ]] && echo "$paused"
}

fmt_json() {
  local text="$1" class="$2"
  printf '{"text":"%s","class":"%s"}' "$(echo "$text" | sed 's/"/\\"/g')" "$class"
}

cmd="${1:-print}"   # print|play-pause|next|prev
player="$(pick_player || true)"

if [[ -z "${player:-}" ]]; then
  [[ "$cmd" == "print" ]] && fmt_json "" "stopped p0"
  exit 0
fi

case "$cmd" in
  play-pause) exec playerctl -p "$player" play-pause ;;
  next)       exec playerctl -p "$player" next ;;
  prev)       exec playerctl -p "$player" previous ;;
esac

status=$(playerctl -p "$player" status 2>/dev/null || echo "Stopped")
title=$(playerctl -p "$player" metadata xesam:title 2>/dev/null || echo "")
artist=$(playerctl -p "$player" metadata xesam:artist 2>/dev/null | paste -sd ", " - || echo "")
text="$title"; [[ -n "$artist" ]] && text="$title — $artist"

# позиция/длина → процент
pos=$(playerctl -p "$player" position 2>/dev/null || echo 0)
len_us=$(playerctl -p "$player" metadata mpris:length 2>/dev/null || echo 0)
pct=0
if [[ -n "$len_us" ]] && [[ "$len_us" -gt 0 ]] 2>/dev/null; then
  len_s=$(awk -v us="$len_us" 'BEGIN{printf "%.6f", us/1000000}')
  pct=$(awk -v p="$pos" -v l="$len_s" 'BEGIN{if(l>0){x=(p/l)*100; if(x<0)x=0; if(x>100)x=100; printf "%.0f", x}else{print 0}}')
fi
# квант 5%
q=$(( (pct/5)*5 )); [[ "$pct" -ge 100 ]] && q=100

class="playing"; [[ "$status" == "Paused" ]] && class="paused"; [[ "$status" == "Stopped" ]] && class="stopped"
fmt_json "$text" "$class p$q"
