{
    "custom/mpris_heart": {
        "return-type": "json",
        "format": "{text}",
        "tooltip": true,
        "interval": 1,
        "signal": 7,
        "exec": "curl -m 1 -fsS http://127.0.0.1:17311/waybar || echo '{\"text\":\" \",\"class\":\"unliked\"}'",
        "on-click": "hypr-yamctl like"
    },

    "custom/ym_mpris": {
        "name": "ym",
        "format": "{text}",
        "markup": "pango",
        "return-type": "json",
        "interval": 1,
        "signal": 6,
        "tooltip": true,
        "exec": "~/.config/waybar/modules/ym_mpris.sh",
        "on-click": "hypr-yamctl play-pause",
        "on-scroll-up": "hypr-yamctl next",
        "on-scroll-down": "hypr-yamctl prev",
        "on-click-middle": "hypr-yamctl volume mute"
    },

    "custom/ym_volume": {
        "return-type": "json",
        "format": "{text}",
        "tooltip": true,
        "interval": 1,
        "signal": 8,
        "exec": "curl -m 1 -fsS http://127.0.0.1:17312/ymvol || echo '{\"text\":\"󰕾 --%\",\"class\":\"ymvol\"}'",
        "on-scroll-up": "hypr-yamctl volume up 2",
        "on-scroll-down": "hypr-yamctl volume down 2",
        "on-click": "hypr-yamctl volume mute",
        "on-click-right": "hypr-yamctl volume set 50"
    }
}
