/* =========================================================================
   Yandex Music Waybar Styling
   ========================================================================= */

/* Heart (Like) button */
#custom-mpris_heart {
  background-color: #111827;
  border-radius: 14px;
  min-width: 20px;
  min-height: 20px;
  padding: 12px;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 28px;
  color: transparent;
}

#custom-mpris_heart.unliked {
  background-image: url("file://{{SVG_DIR}}/heart-dis.svg");
  background-color: #111827;
}

#custom-mpris_heart.liked {
  background-image: url("file://{{SVG_DIR}}/heart-like.svg");
  background-color: #111827;
}

/* Track info & circular progress */
#custom-ym_mpris {
  background-color: #111827;
  border-radius: 14px;
  padding: 6px 10px;
  padding-left: 24px;
  background-repeat: no-repeat;
  background-position: left center;
  background-size: 27px;
  font-size: 13px;
}

#custom-ym_mpris.stopped {
  background-image: url("file://{{SVG_DIR}}/stop.svg");
}

/* Paused states + progress */
#custom-ym_mpris.paused-p0   { background-image: url("file://{{SVG_DIR}}/prog_play/play-00.svg"); padding-left: 50px; background-position: 12px center; }
